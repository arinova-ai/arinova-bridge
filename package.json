{
  "name": "@arinova-ai/arinova-bridge",
  "version": "0.0.3",
  "description": "Multi-provider bridge between Arinova Chat and AI coding assistants (Claude, Codex)",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    ".env.example"
  ],
  "bin": {
    "arinova-bridge": "bin/arinova-bridge.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/setup.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "@arinova-ai/agent-sdk": "0.0.19-staging.8",
    "@arinova-ai/cli": "0.0.27",
    "@arinova-ai/mcp-server": "staging",
    "@arinova-ai/theme-sdk": "0.0.5-staging.0",
    "@inquirer/prompts": "^8.2.1",
    "better-sqlite3": "^11.0.0",
    "js-tiktoken": "^1.0.21",
    "node-pty": "^1.2.0-beta.12"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/sdk": "0.96.0",
      "esbuild": "0.28.1",
      "@hono/node-server": "1.19.13",
      "fast-uri": "3.1.2",
      "hono": "4.12.21",
      "ip-address": "10.2.0",
      "qs": "6.15.2",
      "postcss": "8.5.14",
      "vite": "7.3.2"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^25.3.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.2"
  }
}

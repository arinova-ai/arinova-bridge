{
  "name": "@arinova-ai/arinova-bridge",
  "version": "0.0.3",
  "description": "Multi-provider bridge between Arinova Chat and AI coding assistants (Claude, Codex)",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "arinovaBridge": {
    "pinnedClaudeVersion": "2.1.143"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    ".env.example"
  ],
  "bin": {
    "arinova-bridge": "bin/arinova-bridge.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/setup.ts",
    "test": "vitest run",
    "test:file": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "@arinova-ai/agent-sdk": "0.0.19-staging.6",
    "@arinova-ai/cli": "0.0.24-staging.0",
    "@arinova-ai/mcp-server": "0.0.19-staging.4",
    "@arinova-ai/theme-sdk": "0.0.4-staging.0",
    "@inquirer/prompts": "^8.2.1",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^5.5.0",
    "better-sqlite3": "^11.0.0",
    "js-tiktoken": "^1.0.21",
    "node-pty": "^1.2.0-beta.12"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/sdk": "0.96.0",
      "esbuild": "0.28.1",
      "@hono/node-server": "1.19.13",
      "fast-uri": "3.1.2",
      "hono": "4.12.21",
      "ip-address": "10.2.0",
      "qs": "6.15.2",
      "postcss": "8.5.14",
      "vite": "7.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^25.3.0",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.2"
  }
}
